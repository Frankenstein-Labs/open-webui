# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Task-aware agent routing. Use 'auto' to select by task intent, or force
# 'ai-manus' / 'openhands'.
OPEN_WEBUI_ENGINE='auto'
OPEN_WEBUI_DEFAULT_ENGINE='openhands'

# ai-manus: computer, browser, VNC and sandbox-enabled tasks.
# AI_MANUS_URL='http://ai-manus:8000'
# AI_MANUS_TOKEN=''

# OpenHands Software Agent SDK: coding and repository tasks.
# OPENHANDS_API_KEY=''
# OPENHANDS_BASE_URL=''
# OPENHANDS_MODEL='gpt-4o'
# OPENHANDS_WORKSPACE='/app/workspace'

# ── CORTEX Agent orchestration ──────────────────────────────────────────────
# Capability-routed orchestration across engines. OFF by default: when unset,
# the legacy single-engine path in the gateway is used unchanged.
# CORTEX_AGENT_ORCHESTRATOR='false'
# Allow a task to chain engines when no single engine covers all capabilities.
# CORTEX_AGENT_CHAINING='true'
# Enable the browser capability on the OpenHands engine (cli_mode=False).
# CORTEX_OPENHANDS_BROWSER='true'
# Refuse to run engines in-process; require a remote workspace/server.
# CORTEX_REQUIRE_ISOLATED_RUNTIME='true'
# CORTEX_ALLOW_LOCAL_RUNTIME='true'
# Hosts the orchestrator may reach for engine runtimes (comma-separated).
# CORTEX_ALLOWED_ENDPOINT_HOSTS='ai-manus,openhands'
# CORTEX_ALLOW_PRIVATE_NETWORKS='true'
# Screen (VNC) streaming stays disabled unless explicitly enabled.
# CORTEX_ALLOW_SCREEN_STREAMING='false'
# Tool-call and runtime budgets per session.
# CORTEX_MAX_TOOL_CALLS='200'
# CORTEX_MAX_RUNTIME_SECONDS='3600'
# CORTEX_DENIED_TOOLS=''
# ai-manus authentication: a user bearer token, or a shared JWT secret to mint
# a short-lived service token. A static API token alone cannot create sessions.
# AI_MANUS_JWT_SECRET=''
# AI_MANUS_JWT_ALGORITHM='HS256'
# AI_MANUS_SERVICE_USER='cortex-service'
# AI_MANUS_USERNAME=''
# AI_MANUS_PASSWORD=''

# ── CORTEX shared computer ──────────────────────────────────────────────────
# One machine per task, shared by every engine in the chain, instead of each
# engine starting its own. OFF by default; when off, engines run as before.
# CORTEX_COMPUTER_ENABLED='false'
# Where the machine runs: docker (hardened container CORTEX owns), api (an
# already-running ai-manus sandbox reached over its HTTP API), or local (a host
# directory; development only, refused unless explicitly allowed).
# CORTEX_COMPUTER_KIND='docker'
# CORTEX_COMPUTER_IMAGE='cortex-computer:latest'
# CORTEX_COMPUTER_ALLOWED_IMAGES='cortex-computer:latest'
# Networking inside the sandbox is OFF by default: a task must not choose its
# own egress. The code also drops all capabilities, sets no-new-privileges,
# uses a read-only root with a bounded /tmp and refuses a root user.
# CORTEX_COMPUTER_ALLOW_NETWORK='false'
# CORTEX_COMPUTER_REQUIRE_NON_ROOT='true'
# CORTEX_COMPUTER_MAX_CPUS='2.0'
# CORTEX_COMPUTER_MAX_MEMORY_MB='4096'
# CORTEX_COMPUTER_MAX_COMMANDS='500'
# CORTEX_COMPUTER_COMMAND_TIMEOUT_S='120'
# CORTEX_COMPUTER_MAX_OUTPUT_BYTES='65536'
# Enable the non-Docker kinds. Both are OFF by default on purpose.
# CORTEX_COMPUTER_ALLOW_LOCAL='false'
# CORTEX_COMPUTER_ALLOW_API='false'
# Base URL of the sandbox for CORTEX_COMPUTER_KIND='api'.
# CORTEX_COMPUTER_API_URL='http://sandbox:8080'
# Host directory holding the workspaces of docker/local computers.
# CORTEX_COMPUTER_WORKSPACE_ROOT='/var/lib/cortex/computers'

# ── CORTEX LLM provider ─────────────────────────────────────────────────────
# Provider used by the OpenHands engine. Precedence: CORTEX_LLM_PROVIDER, then
# OPENROUTER_API_KEY presence, then OpenAI. Values: openrouter|openai|anthropic|local
# CORTEX_LLM_PROVIDER='openrouter'
#
# OpenRouter (recommended). Models are addressed as <vendor>/<model>; the
# adapter adds the `openrouter/` prefix expected by the SDK.
# OPENROUTER_API_KEY=''
# OPENROUTER_MODEL='anthropic/claude-sonnet-4.5'
# OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
# Optional OpenRouter app attribution headers.
# OPENROUTER_SITE_URL=''
# OPENROUTER_APP_NAME='CORTEX Web'
#
# Local OpenAI-compatible server (vLLM, Ollama, LM Studio, ...). No API key is
# required, but both the base URL and the model are.
# CORTEX_LLM_BASE_URL=''
# CORTEX_LLM_MODEL=''
# CORTEX_LLM_API_KEY=''
#
# OPENHANDS_* still works and takes precedence over the provider-specific
# variables, so existing deployments need no change.

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
